#!/bin/bash
{%- from "./utils.j2" import cliopts, export_env, export_job_config %}
#SBATCH --account bcuf-delta-gpu
#SBATCH -p {{ queue }}
#SBATCH --nodes {{ nodes or 1 }}
#SBATCH --ntasks-per-node {{ gpus_per_node or 2 }}
#SBATCH --gpus-per-node {{ gpus_per_node or 2 }}
#SBATCH --time {{ walltime or "0:30:00" }}
#SBATCH --constraint="scratch"
#SBATCH --cpus-per-task 16
#SBATCH --mem-per-cpu 4G
{%- if job_array is defined %}
#SBATCH --array={{ job_array.spec }}
{%- endif %}
{%- if requeue %}
#SBATCH --signal=USR1@90
#SBATCH --requeue
#SBATCH --open-mode=append
{%- endif %}

# Training script for delta
set -ex

# Move to git root
cd $(git rev-parse --show-toplevel)

# Activate Environment
module purge
module --ignore_cache load python/3.11.6 openmpi/4.1.6 cuda/12.2.1
source ./activate

# Set env variables
{{- export_env( env ) }}

export TMPDIR=${TMPDIR:-/tmp}

{% if deepspeed is defined %}
# Write out deepspeed config
cat > $TMPDIR/deepspeed.json<<EOF
{{ deepspeed | tojson(indent=4) }}
EOF
export PL_DEEPSPEED_CONFIG_PATH="$TMPDIR/deepspeed.json"
export DEEPSPEED_CONFIG=$(cat $PL_DEEPSPEED_CONFIG_PATH)
{%- endif %}

{% if job_array is defined %}
export PL_CONFIG=$TMPDIR/lightning_${SLURM_JOB_ID}_${SLURM_ARRAY_TASK_ID}.json
sed "${SLURM_ARRAY_TASK_ID}q;d" {{ job_array.file }} > $PL_CONFIG
export JOB_CONFIG=$(cat $PL_CONFIG)
{% else %}

{{- export_job_config( __config__ ) }}

# Write out  lightning config
export PL_CONFIG=$TMPDIR/lightning.json
cat > ${PL_CONFIG}<<EOF
{%- if test is defined %}
{{ {"test": test } | tojson }}
{% else %}
{{ {"fit": train } | tojson }}
{%- endif %}
EOF
{%- endif %}

sbcast --force ${PL_CONFIG} ${PL_CONFIG}

{% if requeue -%}
# Look for a requeue checkpoint
ckpt="./mist/requeue/${SLURM_JOB_ID}"
if [ -d "$ckpt" ]; then
    export PL_FIT__CKPT_PATH="$ckpt"
    export WANDB_ID="$(basename $(dirname $(realpath $ckpt)))"
    export WANDB_RESUME="must"
fi
{%- endif %}

srun \
${PWD}/submit/set_node_rank \
{%- if nsys is defined %}
nsys profile \
      {{- cliopts( nsys ) | indent }} \
{%- endif %}
{%- if container is defined %}
apptainer exec --nv --bind /tmp,/projects,/scratch,/sw {{ container }} \
{%- endif %}
{%- if test is defined %}
    python3 train.py test
{%- else %}
    python3 train.py fit
{%- endif %}
