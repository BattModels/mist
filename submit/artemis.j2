#!/bin/bash
{%- from "./utils.j2" import cliopts, export_env, export_job_config %}
#SBATCH -p {{ queue or "venkvis-debug" }}
#SBATCH --nodes {{ nodes or 1 }}
#SBATCH --ntasks-per-node {{ gpus_per_node or 2 }}
#SBATCH --gpus-per-node {{ gpus_per_node or 2 }}
#SBATCH --time {{ walltime or "0:30:00" }}
#SBATCH --cpus-per-task 16
#SBATCH --mem-per-cpu 2G
#SBATCH --gpu_cmode=shared
{%- if requeue %}
#SBATCH --signal=USR1@90
#SBATCH --requeue
#SBATCH --open-mode=append
{%- endif %}

# Training script for h001
my_job_header
set -ex

# Move to git root
cd $(git rev-parse --show-toplevel)

# Activate Environment
module purge
module --ignore_cache load spack/0.21 python/3.11.5 cuda/12.2 openmpi/4.1.6
source ./activate

# Set env variables
ENV_FILE="${TMPDIR}/env-${SLURM_JOB_ID}.sh"
cat > $ENV_FILE<<EOF
{{- export_env( env ) }}
EOF
source $ENV_FILE
sbcast -fp $ENV_FILE $ENV_FILE

{% if deepspeed is defined %}
# Write out deepspeed config
cat > $TMPDIR/deepspeed.json<<EOF
{{ deepspeed | tojson(indent=4) }}
EOF
export PL_DEEPSPEED_CONFIG_PATH="$TMPDIR/deepspeed.json"
export DEEPSPEED_CONFIG=$(cat $PL_DEEPSPEED_CONFIG_PATH)
{%- endif %}

{{- export_job_config( __config__ ) }}

# Write out  lightning config
export PL_CONFIG=$TMPDIR/lightning-${SLURM_JOB_ID}-${SLURM_ARRAY_TASK_ID:-0}.json
cat > ${PL_CONFIG}<<EOF
{{ {"fit": train } | tojson }}
EOF
sbcast -fp ${PL_CONFIG} ${PL_CONFIG}

{%- if requeue %}
# Look for a requeue checkpoint
ckpt="./mist/requeue/${SLURM_JOB_ID}"
if [ -d "$ckpt" ]; then
    export PL_FIT__CKPT_PATH="$ckpt"
    export WANDB_ID="$(basename $(dirname $(realpath $ckpt)))"
    export WANDB_RESUME="must"
fi
{%- endif %}

srun --mpi=pmix \
{%- if container is defined %}
apptainer exec \
--bind /scratch,/nfs,$TMPDIR \
--env-file $ENV_FILE \
--nv \
{{ container }} \
/opt/uv/uv run \
{%- endif %}
${PWD}/submit/set_node_rank \
{%- if nsys is defined %}
nsys profile \
      {{- cliopts( nsys ) | indent }} \
{%- endif %}
    python3 train.py --config ${PL_CONFIG}
