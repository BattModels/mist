{%- macro cliopts(opts=None) -%}
{%- for k, v in (opts or {}).items()|sort() %}
{{ "--" if (k|length > 1) else "-"}}{{ k }} {{ "'" + v|string() + "'" if (v is sequence and v is not string) else v }} {%-  if not loop.last %} \{% endif %}
{%- endfor %}
{%- endmacro %}

{%- macro export_env(opts=None) -%}
{%- for k, v in (opts or {}).items()|sort() %}
export {{ k + "=" + v|string() }}
{%- endfor %}
{%- endmacro %}

{%- macro export_job_config(config) -%}
# Record configuration
echo "########################################"
export JOB_CONFIG='
{{ config | tojson(indent=4) }}
'
echo "$JOB_CONFIG"
echo "########################################"
{%- endmacro %}
