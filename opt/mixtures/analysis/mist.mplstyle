figure.constrained_layout.use : True
xtick.labelsize              : 4
ytick.labelsize              : 4
lines.markersize             : 2
lines.linewidth              : 1
font.size                    : 5
font.weight                  : bold
axes.titlesize               : 4
axes.labelsize               : 5
legend.fontsize              : 4
font.family                  : Serif
grid.linewidth               : 0.1
figure.dpi                   : 500
savefig.dpi                  : 500
mathtext.fontset             : stix
