IONIC_MODELS = {"mist-1p8b": ionic_1p8b.outputs.model}

# Public, unaugmented olfactory-mixture observations. CID zeroes are padding.
OLFACTORY_RELEASE = "https://raw.githubusercontent.com/Satarifard/CWYK-Olfboost/d1779fc9c632e279aed80ae2c945031a8dbf6080/"
olfactory_sources = {}
for key, relative, digest, size in [
    ("definitions", "augmentation/Mixure_Definitions_Original.csv", "46d8fcc54bd08aedd366271a4f54fbfa35e8cb21e2a15b00b4c00dc8bed15ba6", 141855),
    ("annotations", "augmentation/gt_with_dataset_Original.csv", "3990217f0136adf3826044126949d9df48443b54e533204d47b18765cdc68502", 23736),
    ("identities", "odor-pair-model/CID_SMILES.csv", "70c8a56299139b824d35636f28f78b8b97d74df39142a13da25b489592bc5c98", 13047),
]:
    directory = Path("//data/releases/olfboost-d1779fc9")
    filename = key + ".csv"
    olfactory_sources[key] = task(
        name="benchmark-olfactory-mixtures-fetch-" + key,
        cmd=[environment.outputs.python, Path("//electrolyte_fm/utils/fetch_file.py"),
             OLFACTORY_RELEASE + relative, directory / filename] + sh.args({
            "sha256": digest, "bytes": size,
        }),
        env=ENV,
        executor=shell(),
        output_dir=directory,
        outputs={"data": Path(filename)},
        validator=validate_checksums(),
    ).outputs.data

OLFACTORY_MIXTURE_DATA = task(
    name="benchmark-olfactory-mixtures-materialize-split",
    requires=[environment],
    working_directory=Path("//"),
    cmd=benchmark_command("materialize_olfactory_mixtures")
        + sh.args(dict(olfactory_sources, **{
            "seed": 42,
            "output-dir": Path("//data/olfactory-mixtures/seed42"),
        })),
    env=OFFLINE,
    executor=shell(),
    output_dir=Path("//data/olfactory-mixtures"),
    outputs={"dataset": Path("seed42")},
    validator=validate_checksums(),
)
OLFACTORY_MIXTURE_MODELS = {}
for base in BASE_MODELS:
    output = ROOT / base / "olfactory-mixtures"
    fitted = task(
        name="benchmark-" + base + "-olfactory-mixtures-fit",
        tags=tags("training"),
        requires=[environment],
        working_directory=Path("//"),
        cmd=benchmark_command("train_olfactory_mixtures") + sh.args({
            "dataset": OLFACTORY_MIXTURE_DATA.outputs.dataset,
            "model": BASE_MODELS[base],
            "output-dir": output,
            "precision": "bf16-mixed" if base == "mist-1p8b" else "32-true",
            "optimizer-offload": base == "mist-1p8b",
        }),
        env=OFFLINE,
        resources=GPU,
        output_dir=output,
        outputs={"model": Path("model"), "training": Path("training.json")},
        restartable=True,
        max_attempts=24,
        validator=validate_checksums(),
    )
    OLFACTORY_MIXTURE_MODELS[base] = fitted.outputs.model
